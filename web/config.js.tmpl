  VITE_JURISDICTION: {{env "VITE_JURISDICTION" | toJson}},
  VITE_HOSTING_PROVIDER: {{env "VITE_HOSTING_PROVIDER" | toJson}},
  VITE_LEGAL_UPDATED: {{env "VITE_LEGAL_UPDATED" | toJson}},
  VITE_BACKUP_RETENTION_DAYS: {{env "VITE_BACKUP_RETENTION_DAYS" | toJson}},
  VITE_GITHUB_REPO: {{env "VITE_GITHUB_REPO" | toJson}},
};
