# Copy to router/.env and fill in the values. The router and docker compose (via make) read this file.

# ---- HTTP ----
PORT=3000

# ---- Auth / OAuth ----
# At least 32 random characters (openssl rand -hex 32). Signs access and agent tokens (HS256).
# The router refuses to start in production with a short or placeholder value.
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL of this server (OAuth issuer + protected resource).
OAUTH_ISSUER=https://file-read-write-mcp.about-bewton.dev
MCP_RESOURCE_URL=https://file-read-write-mcp.about-bewton.dev/mcp
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# ---- Accounts ----
# Resend (https://resend.com) sends verification and password-reset emails.
# Leave RESEND_API_KEY empty in development: emails are printed to the router log instead.
RESEND_API_KEY=
EMAIL_FROM="FileReadWrite <no-reply@mcp.example.com>"
# GitHub OAuth app for "Continue with GitHub" (optional; the button hides when unset).
# Callback URL: <OAUTH_ISSUER>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Per-account limits.
MAX_AGENTS_PER_USER=10
TOOL_CALLS_PER_MINUTE=120

# ---- Database (Postgres via docker-compose) ----
POSTGRES_USER=mcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mcp
# Inside docker-compose this is overridden to point at the "db" service.
# Set it here only when running the router directly against a local Postgres.
DATABASE_URL=postgres://mcp:change-me@localhost:5432/mcp

# ---- Caddy (TLS reverse proxy) ----
DOMAIN=mcp.example.com
ACME_EMAIL=you@example.com

# ---- Agent self-update (GitHub Releases -> router cache) ----
# Repo whose GitHub Releases provide the agent-<target> binaries.
GITHUB_OWNER=theeurbanlegend
GITHUB_REPO=filereadwritemcp
# Only needed if that repo is private (fine-grained token, Contents: read).
GITHUB_TOKEN=
# Shared secret set on the GitHub webhook (repo Settings -> Webhooks).
GITHUB_WEBHOOK_SECRET=
# Where the router caches the latest release's binaries (persisted volume).
RELEASES_DIR=/data/releases

