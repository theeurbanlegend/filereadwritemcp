{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileReadWrite",
  "version": "../package.json",
  "identifier": "dev.about-bewton.filereadwrite",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FileReadWrite",
        "width": 440,
        "height": 640,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#05060f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "publisher": "FileReadWrite",
    "homepage": "https://github.com/theeurbanlegend/filereadwritemcp",
    "license": "AGPL-3.0-only",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "shortDescription": "Let your AI apps use folders on this computer, with your approval.",
    "externalBin": ["binaries/frw-agent"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMzk3MzY1NEM1MTk2ODEKUldTQmxsRk1aWE01WUYyMW9oMW1Ta2wrd3ROZ0YyTGl6dXhGL1hmWFVoSGxnRUhFTkxDckQ4cTcK",
      "endpoints": [
        "https://github.com/theeurbanlegend/filereadwritemcp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
