{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the launcher windows may call",
  "windows": ["main", "approval"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask"
  ]
}
